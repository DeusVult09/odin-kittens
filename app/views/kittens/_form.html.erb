<%= form_with model: kitten |form | %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div><br>

  <div>
    <%= form.label :age %>
    <%= form.text_field :age %>
  </div><br>

  <div>
    <%= form.label :cuteness %>
    <%= form.text_field :cuteness %>
  </div><br>

  <div>
    <%= form.label :softeness %>
    <%= form.text_field :softeness %>
  </div>
<% end %>